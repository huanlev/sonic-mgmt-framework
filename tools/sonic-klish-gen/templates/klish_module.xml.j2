<?xml version="1.0" encoding="UTF-8"?>
<!--
Auto-generated Klish CLI XML
Generated by: sonic-klish-gen
Module: {{ module.name }}
-->

<CLISH_MODULE
    xmlns="http://www.dellemc.com/sonic/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:xi="http://www.w3.org/2001/XInclude"
    xsi:schemaLocation="http://www.dellemc.com/sonic/XMLSchema
                        http://www.dellemc.com/sonic/XMLSchema/clish.xsd"
    >
{% for view in module.views %}
<VIEW name="{{ view.name }}"{% if view.prompt %} prompt="{{ view.prompt }}"{% endif %}{% if view.depth %} depth="{{ view.depth }}"{% endif %}>
{% for command in view.commands %}
    <COMMAND name="{{ command.name }}"
        help="{{ command.help }}"
        {%- if command.view %} view="{{ command.view }}"{% endif %}
        {%- if command.viewid %} viewid="{{ command.viewid }}"{% endif %}
        >
{% for param in command.params %}
        <PARAM
            name="{{ param.name }}"
            help="{{ param.help }}"
            ptype="{{ param.ptype }}"
            {%- if param.optional %} optional="true"{% endif %}
            {%- if param.mode %} mode="{{ param.mode }}"{% endif %}
            {%- if param.value %} value="{{ param.value }}"{% endif %}
            />
{% endfor %}
{% if command.action %}
        <ACTION>
{{ command.action.to_shell_script() }}        </ACTION>
{% endif %}
    </COMMAND>

{% endfor %}
</VIEW>

{% endfor %}
</CLISH_MODULE>
